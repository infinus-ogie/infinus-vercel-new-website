# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# Production/Vercel env snapshots — never commit these.
# `vercel env pull` writes REAL values into these files (including short-lived
# VERCEL_OIDC_TOKEN JWTs and every NEXT_PUBLIC_* value). They are machine-specific
# build snapshots, not configuration: the source of truth is the Vercel dashboard.
# .env.production and .env.production.tmp were tracked until this rule was added.
.env
.env.*
# Value-free templates may still be committed deliberately.
!.env.example
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
